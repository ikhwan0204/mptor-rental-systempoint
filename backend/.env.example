PORT=4000
JWT_SECRET=change_this_to_a_random_secret_string
FRONTEND_URL=http://localhost:5173

# Google Login (optional) - get this from Google Cloud Console
# See README.md "Setup Google Login" section for step-by-step guide
GOOGLE_CLIENT_ID=

# Real SMTP (optional) - leave blank to use Ethereal (fake email, dev only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
